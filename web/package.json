{
  "name": "@secretpad/monorepo",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "pnpm --filter @secretpad/app dev",
    "build": "pnpm --filter \"@secretpad/*\" build",
    "typecheck": "pnpm --filter \"@secretpad/*\" typecheck",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "test": "vitest run",
    "codegen:openapi": "tsx scripts/codegen-openapi.ts",
    "clean": "rimraf node_modules apps/*/.vite apps/*/dist packages/*/dist",
    "prepare": "cd .. && husky web/.husky"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": "eslint --fix",
    "packages/**/*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
