# =============================================================================
# 测试环境专用的 Vite 环境变量（vitest 会自动加载 .env.test）。
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL：
#   单元测试 / 集成测试运行在 jsdom（Node）环境中，没有真实的浏览器地址栏，
#   openapi-fetch 内部通过 `new URL(path, baseUrl)` 构造请求地址，
#   若 baseUrl 为空字符串会抛出 "Invalid URL"。
#   因此在测试环境显式提供一个 base URL，使相对路径（如 /api/login）可被正确解析。
#   MSW 仍按「路径」匹配请求，base 的 host 部分不影响拦截。
# =============================================================================
VITE_API_BASE_URL=http://localhost
