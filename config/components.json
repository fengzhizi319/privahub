  {
    "code_name": "data_prep/psi",
    "domain": "data_prep",
    "name": "psi",
    "category": "data_prep",
    "version": "1.0.0",
    "description": "Private set intersection between multiple parties",
    "desc": "PSI between two parties.",
    "attrs": [
      {"name": "protocol", "desc": "PSI protocol.", "type": "AT_UNION_GROUP", "union": {"defaultSelection": "PROTOCOL_RR22"}},
      {"prefixes": ["protocol"], "name": "PROTOCOL_ECDH", "desc": "ECDH protocol.", "type": "AT_UNION_GROUP", "union": {"defaultSelection": "CURVE_25519"}},
      {"prefixes": ["protocol", "PROTOCOL_ECDH"], "name": "CURVE_25519", "desc": "CURVE_25519"},
      {"prefixes": ["protocol", "PROTOCOL_ECDH"], "name": "CURVE_FOURQ", "desc": "CURVE_FOURQ"},
      {"prefixes": ["protocol", "PROTOCOL_ECDH"], "name": "CURVE_SM2", "desc": "CURVE_SM2"},
      {"prefixes": ["protocol", "PROTOCOL_ECDH"], "name": "CURVE_SECP256K1", "desc": "CURVE_SECP256K1"},
      {"prefixes": ["protocol"], "name": "PROTOCOL_RR22", "desc": "RR22 protocol."},
      {"prefixes": ["protocol"], "name": "PROTOCOL_KKRT", "desc": "KKRT protocol."},
      {"name": "sort_result", "desc": "If false, output is not promised to be aligned.", "type": "AT_BOOL", "atomic": {"isOptional": true, "defaultValue": {"b": true}}},
      {"name": "receiver_parties", "desc": "Party names of receiver for result.", "type": "AT_PARTY", "atomic": {"listMaxLengthInclusive": "2"}},
      {"name": "allow_empty_result", "desc": "Whether to allow the result to be empty.", "type": "AT_BOOL", "atomic": {"isOptional": true, "defaultValue": {"b": false}}},
      {"name": "check_hash_digest", "desc": "Check hash digest consistency between parties.", "type": "AT_BOOL", "atomic": {"isOptional": true, "defaultValue": {"b": false}}}
    ],
    "inputs": [
      {"name": "input_ds1", "desc": "Input vertical table for party 1.", "types": ["sf.table.vertical"], "attrs": [{"name": "keys", "desc": "Column(s) used as join keys.", "colMinCntInclusive": "1", "colMaxCntInclusive": "1"}]},
      {"name": "input_ds2", "desc": "Input vertical table for party 2.", "types": ["sf.table.vertical"], "attrs": [{"name": "keys", "desc": "Column(s) used as join keys.", "colMinCntInclusive": "1", "colMaxCntInclusive": "1"}]}
    ],
    "outputs": [
      {"name": "output_ds", "desc": "Output vertical table after PSI.", "types": ["sf.table.vertical"]}
    ]
  },
