# Copy to privahub.env (gitignored), fill in, `chmod 600 privahub.env`.
# Generate secrets with: openssl rand -hex 32
PRIVAHUB_AUTH_JWT_SECRET=
PRIVAHUB_CRYPTO_AES_KEY=
# Inner (node-to-node) port auth is mandatory in production, even on loopback.
PRIVAHUB_SERVER_INNER_AUTH_TOKEN=
# Initial admin: leave empty to get a random one-time password written to
# /app/data/initial-admin-password; read it once with
#   docker compose cp privahub:/app/data/initial-admin-password - | tar -xO
# Production requires TLS on the main port or a declared TLS proxy:
# PRIVAHUB_SERVER_BEHIND_TLS_PROXY=true
# PRIVAHUB_SERVER_TRUSTED_PROXIES=172.18.0.0/16
# Local evaluation only (keeps dev defaults, never in production):
# PRIVAHUB_PROFILE=dev
